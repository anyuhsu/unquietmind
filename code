<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#155e75" />
  <title>Calm the Unquiet Mind｜安定日誌</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: '#18343b',
            ocean: '#155e75',
            mint: '#dff4ef',
            cloud: '#f4f8f7',
            coral: '#e87968'
          },
          fontFamily: {
            sans: ['ui-rounded', '"Noto Sans TC"', 'system-ui', 'sans-serif']
          },
          boxShadow: {
            soft: '0 18px 45px rgba(20,67,75,.10)'
          }
        }
      }
    };
  </script>

  <style>
    input[type="range"] { accent-color: #155e75; }
    input[type="checkbox"] { accent-color: #155e75; }

    .tab[aria-selected="true"] {
      background: #155e75;
      color: white;
      box-shadow: 0 7px 18px rgba(21,94,117,.22);
    }

    .card {
      background: rgba(255,255,255,.92);
      border: 1px solid rgba(21,94,117,.10);
      border-radius: 1.5rem;
      box-shadow: 0 18px 45px rgba(20,67,75,.08);
    }

    .field {
      width: 100%;
      border: 1px solid #cbdeda;
      border-radius: .9rem;
      background: white;
      padding: .72rem .85rem;
      color: #18343b;
      outline: none;
    }

    .field:focus {
      border-color: #155e75;
      box-shadow: 0 0 0 3px rgba(21,94,117,.12);
    }

    @media (prefers-reduced-motion: no-preference) {
      .view { animation: rise .25s ease-out; }

      @keyframes rise {
        from { opacity: 0; transform: translateY(7px); }
        to { opacity: 1; transform: none; }
      }
    }
  </style>
</head>

<body class="min-h-screen bg-cloud text-ink selection:bg-mint">
  <div class="fixed inset-x-0 top-0 -z-10 h-48 bg-gradient-to-br from-cyan-900 via-ocean to-teal-700"></div>

  <main class="mx-auto max-w-5xl px-4 pb-12 pt-7 sm:px-6">
    <header class="mb-5 flex items-start justify-between gap-4 text-white">
      <div>
        <p class="mb-1 text-sm font-semibold tracking-[.18em] text-cyan-100">
          安定日誌
        </p>

        <h1 class="text-2xl font-bold sm:text-3xl">
          Calm the Unquiet Mind
        </h1>

        <p class="mt-1 text-sm text-cyan-50/85">
          每天兩分鐘，看見自己的節奏。
        </p>
      </div>

      <div
        id="saveState"
        class="rounded-full bg-white/15 px-3 py-1.5 text-xs backdrop-blur"
      >
        僅儲存在此裝置
      </div>
    </header>

    <nav class="card mb-5 grid grid-cols-3 gap-1.5 p-1.5" aria-label="主要功能">
      <button
        class="tab rounded-xl px-2 py-3 text-sm font-bold"
        data-view="today"
        aria-selected="true"
      >
        今日記錄
      </button>

      <button
        class="tab rounded-xl px-2 py-3 text-sm font-bold"
        data-view="trend"
        aria-selected="false"
      >
        月度趨勢
      </button>

      <button
        class="tab rounded-xl px-2 py-3 text-sm font-bold"
        data-view="history"
        aria-selected="false"
      >
        歷史資料
      </button>
    </nav>

    <section id="today" class="view">
      <form id="entryForm" class="grid gap-5 lg:grid-cols-[1.08fr_.92fr]">
        <div class="card p-5 sm:p-7">
          <div class="mb-6 flex items-center justify-between gap-3">
            <div>
              <p class="text-sm text-slate-500">日期</p>

              <input
                id="date"
                type="date"
                required
                class="mt-1 bg-transparent text-xl font-bold outline-none"
              />
            </div>

            <span
              id="editBadge"
              class="hidden rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800"
            >
              編輯紀錄
            </span>
          </div>

          <label class="block text-sm font-bold" for="mood">
            今天的心情
            <span id="moodText" class="ml-2 text-ocean">平穩 · 5</span>
          </label>

          <input
            id="mood"
            type="range"
            min="1"
            max="10"
            value="5"
            class="mt-4 w-full"
          />

          <div class="mt-1 flex justify-between text-xl" aria-hidden="true">
            <span>😞</span>
            <span>😕</span>
            <span>😐</span>
            <span>🙂</span>
            <span>😄</span>
          </div>

          <div class="mt-7 grid grid-cols-2 gap-4">
            <label class="text-sm font-bold">
              入睡時間
              <input id="sleepTime" type="time" class="field mt-2" />
            </label>

            <label class="text-sm font-bold">
              起床時間
              <input id="wakeTime" type="time" class="field mt-2" />
            </label>

            <label class="text-sm font-bold">
              睡眠時數
              <input
                id="sleepHours"
                type="number"
                min="0"
                max="24"
                step="0.5"
                placeholder="例如 7.5"
                class="field mt-2"
              />
            </label>

            <label class="text-sm font-bold">
              睡眠品質

              <select id="sleepQuality" class="field mt-2">
                <option value="">未填寫</option>
                <option value="1">1 · 很差</option>
                <option value="2">2 · 偏差</option>
                <option value="3">3 · 普通</option>
                <option value="4">4 · 不錯</option>
                <option value="5">5 · 很好</option>
              </select>
            </label>
          </div>

          <label class="mt-6 block text-sm font-bold">
            今天想留下的話

            <textarea
              id="note"
              rows="3"
              maxlength="500"
              placeholder="發生了什麼？身體或情緒有什麼感覺？"
              class="field mt-2 resize-y"
            ></textarea>
          </label>
        </div>

        <div class="space-y-5">
          <div class="card p-5 sm:p-6">
            <h2 class="text-lg font-bold">服藥紀錄</h2>

            <label class="mt-4 flex cursor-pointer items-center gap-3 rounded-2xl bg-mint/70 p-4">
              <input id="medTaken" type="checkbox" class="h-5 w-5" />

              <span>
                <strong class="block">今天已按醫囑服藥</strong>
                <small class="text-slate-600">
                  只記錄是否服用，不提供劑量建議
                </small>
              </span>
            </label>

            <label class="mt-3 block text-sm font-bold">
              備註

              <input
                id="medNote"
                class="field mt-2"
                maxlength="120"
                placeholder="例如：晚間服用、忘記一劑"
              />
            </label>
          </div>

          <div class="card p-5 sm:p-6">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-bold">輕躁症狀觀察</h2>

              <span
                id="symptomCount"
                class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold"
              >
                0 項
              </span>
            </div>

            <div id="symptoms" class="mt-4 grid gap-2"></div>
          </div>

          <button
            type="submit"
            class="w-full rounded-2xl bg-ocean px-5 py-4 font-bold text-white shadow-lg shadow-cyan-900/20 transition hover:bg-cyan-800 focus:outline-none focus:ring-4 focus:ring-cyan-700/20"
          >
            儲存今天的紀錄
          </button>
        </div>
      </form>

      <aside class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950">
        <strong>溫柔提醒：</strong>
        這個工具用來協助自我觀察，不能取代醫師診斷。若出現連續數日幾乎不需睡眠、衝動失控、自傷念頭或無法確保安全，請立即聯絡信任的人、你的醫療團隊，或當地緊急服務。
      </aside>
    </section>

    <section id="trend" class="view hidden space-y-5">
      <div class="card p-5 sm:p-7">
        <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
          <div>
            <label for="monthPick" class="text-sm font-bold text-slate-600">
              查看月份
            </label>

            <input id="monthPick" type="month" class="field mt-2" />
          </div>

          <p id="monthSummary" class="text-sm text-slate-600"></p>
        </div>

        <div class="relative h-72 w-full">
          <canvas
            id="chart"
            aria-label="每月心情與睡眠趨勢圖"
          ></canvas>
        </div>

        <div class="mt-4 flex flex-wrap gap-4 text-sm">
          <span>
            <i class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-ocean"></i>
            心情（1–10）
          </span>

          <span>
            <i class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-coral"></i>
            睡眠時數
          </span>
        </div>
      </div>

      <div id="insights" class="grid gap-4 sm:grid-cols-3"></div>
    </section>

    <section id="history" class="view hidden space-y-5">
      <div class="card p-5 sm:p-7">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-bold">歷史紀錄</h2>
            <p id="recordCount" class="mt-1 text-sm text-slate-500">
              共 0 筆
            </p>
          </div>

          <div class="flex flex-wrap gap-2">
            <button
              id="exportBtn"
              type="button"
              class="rounded-xl border border-ocean px-3 py-2 text-sm font-bold text-ocean"
            >
              匯出備份
            </button>

            <label class="cursor-pointer rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold">
              匯入備份

              <input
                id="importInput"
                type="file"
                accept="application/json"
                class="hidden"
              />
            </label>
          </div>
        </div>

        <div id="historyList" class="mt-5 space-y-3"></div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-4 text-sm text-slate-600">
        <strong class="text-ink">隱私說明：</strong>
        資料只會存於目前瀏覽器的 LocalStorage，不會自動上傳。清除瀏覽資料、換裝置或使用無痕模式可能使紀錄消失，請定期匯出備份。
      </div>
    </section>
  </main>

  <div
    id="toast"
    role="status"
    aria-live="polite"
    class="pointer-events-none fixed bottom-5 left-1/2 hidden -translate-x-1/2 rounded-full bg-ink px-5 py-3 text-sm font-bold text-white shadow-xl"
  ></div>

  <script>
    const KEY = 'calmMindEntriesV1';

    const symptomOptions = [
      '睡眠需求明顯減少',
      '想法快速、停不下來',
      '說話比平常多或快',
      '精力或活動量增加',
      '注意力容易分散',
      '異常自信或亢奮',
      '衝動消費／冒險行為',
      '明顯易怒或坐立不安'
    ];

    const $ = id => document.getElementById(id);

    let entries = load();
    let editingDate = null;

    function localDate(date = new Date()) {
      const adjusted = new Date(
        date - date.getTimezoneOffset() * 60000
      );

      return adjusted.toISOString().slice(0, 10);
    }

    function load() {
      try {
        const value = JSON.parse(localStorage.getItem(KEY) || '[]');
        return Array.isArray(value) ? value : [];
      } catch {
        return [];
      }
    }

    function persist() {
      localStorage.setItem(KEY, JSON.stringify(entries));
      $('saveState').textContent = '✓ 已儲存在此裝置';

      setTimeout(() => {
        $('saveState').textContent = '僅儲存在此裝置';
      }, 1800);
    }

    function toast(message) {
      $('toast').textContent = message;
      $('toast').classList.remove('hidden');

      setTimeout(() => {
        $('toast').classList.add('hidden');
      }, 2200);
    }

    function escapeHtml(value = '') {
      return String(value).replace(/[&<>'"]/g, character => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      })[character]);
    }

    symptomOptions.forEach((symptom, index) => {
      $('symptoms').insertAdjacentHTML(
        'beforeend',
        `
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-3 text-sm">
            <input
              type="checkbox"
              value="${index}"
              class="symptom h-4 w-4"
            />
            <span>${symptom}</span>
          </label>
        `
      );
    });

    function moodLabel(number) {
      if (number <= 2) return '低落';
      if (number <= 4) return '偏低';
      if (number <= 6) return '平穩';
      if (number <= 8) return '愉快';
      return '高昂';
    }

    function updateMood() {
      const mood = Number($('mood').value);
      $('moodText').textContent = `${moodLabel(mood)} · ${mood}`;
    }

    function updateSymptoms() {
      const count = document.querySelectorAll('.symptom:checked').length;
      $('symptomCount').textContent = `${count} 項`;
    }

    $('mood').addEventListener('input', updateMood);

    document.querySelectorAll('.symptom').forEach(checkbox => {
      checkbox.addEventListener('change', updateSymptoms);
    });

    $('date').value = localDate();
    $('monthPick').value = localDate().slice(0, 7);

    document.querySelectorAll('.tab').forEach(button => {
      button.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(tab => {
          tab.setAttribute('aria-selected', tab === button);
        });

        document.querySelectorAll('.view').forEach(view => {
          view.classList.toggle(
            'hidden',
            view.id !== button.dataset.view
          );
        });

        if (button.dataset.view === 'trend') renderTrend();
        if (button.dataset.view === 'history') renderHistory();
      });
    });

    $('entryForm').addEventListener('submit', event => {
      event.preventDefault();

      const date = $('date').value;

      const item = {
        date,
        mood: Number($('mood').value),
        sleepTime: $('sleepTime').value,
        wakeTime: $('wakeTime').value,
        sleepHours:
          $('sleepHours').value === ''
            ? null
            : Number($('sleepHours').value),
        sleepQuality:
          $('sleepQuality').value === ''
            ? null
            : Number($('sleepQuality').value),
        medTaken: $('medTaken').checked,
        medNote: $('medNote').value.trim(),
        symptoms: [
          ...document.querySelectorAll('.symptom:checked')
        ].map(checkbox => Number(checkbox.value)),
        note: $('note').value.trim(),
        updatedAt: new Date().toISOString()
      };

      entries = entries.filter(entry => entry.date !== date);
      entries.push(item);
      entries.sort((a, b) => a.date.localeCompare(b.date));

      persist();

      editingDate = null;
      $('editBadge').classList.add('hidden');
      toast('紀錄已安全儲存');
    });

    function fillForm(item) {
      ['date', 'sleepTime', 'wakeTime', 'medNote', 'note']
        .forEach(key => {
          $(key).value = item[key] || '';
        });

      $('mood').value = item.mood;
      $('sleepHours').value = item.sleepHours ?? '';
      $('sleepQuality').value = item.sleepQuality ?? '';
      $('medTaken').checked = Boolean(item.medTaken);

      document.querySelectorAll('.symptom').forEach(checkbox => {
        checkbox.checked = item.symptoms?.includes(
          Number(checkbox.value)
        );
      });

      editingDate = item.date;
      $('editBadge').classList.remove('hidden');

      updateMood();
      updateSymptoms();

      document.querySelector('[data-view="today"]').click();
      scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderHistory() {
      const history = [...entries].reverse();

      $('recordCount').textContent = `共 ${history.length} 筆紀錄`;

      $('historyList').innerHTML = history.length
        ? history.map(item => `
            <article class="rounded-2xl border border-slate-200 p-4">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <time class="font-bold">${escapeHtml(item.date)}</time>

                  <p class="mt-1 text-sm text-slate-600">
                    心情 ${item.mood}/10 ·
                    睡眠 ${item.sleepHours ?? '—'} 小時 ·
                    症狀 ${item.symptoms?.length || 0} 項 ·
                    ${item.medTaken ? '已服藥' : '未勾選服藥'}
                  </p>

                  ${item.note
                    ? `<p class="mt-2 text-sm">${escapeHtml(item.note)}</p>`
                    : ''
                  }
                </div>

                <div class="flex shrink-0 gap-2">
                  <button
                    class="edit rounded-lg bg-mint px-2.5 py-1.5 text-xs font-bold"
                    data-date="${item.date}"
                  >
                    編輯
                  </button>

                  <button
                    class="del rounded-lg bg-red-50 px-2.5 py-1.5 text-xs font-bold text-red-700"
                    data-date="${item.date}"
                  >
                    刪除
                  </button>
                </div>
              </div>
            </article>
          `).join('')
        : `
            <div class="rounded-2xl bg-slate-50 p-8 text-center text-slate-500">
              還沒有紀錄。從今天寫下第一筆吧。
            </div>
          `;

      document.querySelectorAll('.edit').forEach(button => {
        button.onclick = () => {
          fillForm(
            entries.find(entry => entry.date === button.dataset.date)
          );
        };
      });

      document.querySelectorAll('.del').forEach(button => {
        button.onclick = () => {
          const confirmed = confirm(
            `確定刪除 ${button.dataset.date} 的紀錄嗎？此動作無法復原。`
          );

          if (confirmed) {
            entries = entries.filter(
              entry => entry.date !== button.dataset.date
            );

            persist();
            renderHistory();
            toast('紀錄已刪除');
          }
        };
      });
    }

    function renderTrend() {
      const month = $('monthPick').value;

      const data = entries.filter(entry => {
        return entry.date.startsWith(month);
      });

      const days = new Date(
        Number(month.slice(0, 4)),
        Number(month.slice(5, 7)),
        0
      ).getDate();

      const canvas = $('chart');
      const box = canvas.parentElement;
      const ratio = devicePixelRatio || 1;

      canvas.width = box.clientWidth * ratio;
      canvas.height = box.clientHeight * ratio;

      const context = canvas.getContext('2d');
      context.scale(ratio, ratio);

      const width = box.clientWidth;
      const height = box.clientHeight;

      const padding = {
        left: 34,
        right: 12,
        top: 16,
        bottom: 30
      };

      context.clearRect(0, 0, width, height);
      context.font = '12px system-ui';
      context.fillStyle = '#64748b';
      context.strokeStyle = '#d9e6e3';
      context.lineWidth = 1;

      for (let value = 0; value <= 10; value += 2) {
        const y =
          padding.top +
          (10 - value) *
          (height - padding.top - padding.bottom) / 10;

        context.beginPath();
        context.moveTo(padding.left, y);
        context.lineTo(width - padding.right, y);
        context.stroke();
        context.fillText(value, 8, y + 4);
      }

      function drawPoints(key, color) {
        context.strokeStyle = color;
        context.lineWidth = 2.5;
        context.beginPath();

        let started = false;

        for (let day = 1; day <= days; day++) {
          const item = data.find(entry => {
            return Number(entry.date.slice(8)) === day;
          });

          const value = item?.[key];

          if (value == null) continue;

          const x =
            padding.left +
            (day - 1) *
            (width - padding.left - padding.right) /
            (days - 1);

          const y =
            padding.top +
            (10 - Math.min(10, value)) *
            (height - padding.top - padding.bottom) / 10;

          if (!started) {
            context.moveTo(x, y);
            started = true;
          } else {
            context.lineTo(x, y);
          }
        }

        context.stroke();

        data.forEach(item => {
          const value = item[key];

          if (value == null) return;

          const day = Number(item.date.slice(8));

          const x =
            padding.left +
            (day - 1) *
            (width - padding.left - padding.right) /
            (days - 1);

          const y =
            padding.top +
            (10 - Math.min(10, value)) *
            (height - padding.top - padding.bottom) / 10;

          context.fillStyle = color;
          context.beginPath();
          context.arc(x, y, 3.5, 0, Math.PI * 2);
          context.fill();
        });
      }

      drawPoints('mood', '#155e75');
      drawPoints('sleepHours', '#e87968');

      for (
        let day = 1;
        day <= days;
        day += Math.max(1, Math.ceil(days / 7))
      ) {
        const x =
          padding.left +
          (day - 1) *
          (width - padding.left - padding.right) /
          (days - 1);

        context.fillStyle = '#64748b';
        context.fillText(day, x - 3, height - 8);
      }

      function average(key) {
        const values = data
          .map(item => item[key])
          .filter(value => value != null);

        return values.length
          ? (
              values.reduce((total, value) => total + value, 0) /
              values.length
            ).toFixed(1)
          : '—';
      }

      const symptomTotal = data.reduce((total, item) => {
        return total + (item.symptoms?.length || 0);
      }, 0);

      $('monthSummary').textContent = data.length
        ? `${data.length} 天有紀錄`
        : '這個月尚無紀錄';

      const insightData = [
        [average('mood'), '平均心情', '/ 10'],
        [average('sleepHours'), '平均睡眠', '小時'],
        [symptomTotal, '症狀勾選', '次']
      ];

      $('insights').innerHTML = insightData.map(item => `
        <div class="card p-5">
          <p class="text-sm text-slate-500">${item[1]}</p>

          <p class="mt-2 text-3xl font-bold text-ocean">
            ${item[0]}
            <small class="text-sm text-slate-500">${item[2]}</small>
          </p>
        </div>
      `).join('');
    }

    $('monthPick').addEventListener('change', renderTrend);

    window.addEventListener('resize', () => {
      if (!$('trend').classList.contains('hidden')) {
        renderTrend();
      }
    });

    $('exportBtn').onclick = () => {
      const backup = {
        app: 'Calm the Unquiet Mind',
        version: 1,
        exportedAt: new Date().toISOString(),
        entries
      };

      const blob = new Blob(
        [JSON.stringify(backup, null, 2)],
        { type: 'application/json' }
      );

      const link = document.createElement('a');

      link.href = URL.createObjectURL(blob);
      link.download = `calm-mind-backup-${localDate()}.json`;
      link.click();

      URL.revokeObjectURL(link.href);
      toast('備份檔已下載');
    };

    $('importInput').onchange = async event => {
      const file = event.target.files[0];

      if (!file) return;

      try {
        const raw = JSON.parse(await file.text());
        const incoming = Array.isArray(raw) ? raw : raw.entries;

        const valid =
          Array.isArray(incoming) &&
          incoming.every(item => {
            return /^\d{4}-\d{2}-\d{2}$/.test(item.date);
          });

        if (!valid) throw new Error('Invalid backup');

        const confirmed = confirm(
          `將匯入 ${incoming.length} 筆紀錄；相同日期會以備份內容取代。繼續嗎？`
        );

        if (!confirmed) return;

        const map = new Map(
          entries.map(item => [item.date, item])
        );

        incoming.forEach(item => {
          map.set(item.date, item);
        });

        entries = [...map.values()].sort((a, b) => {
          return a.date.localeCompare(b.date);
        });

        persist();
        renderHistory();
        toast('備份已匯入');
      } catch {
        alert(
          '無法讀取這個備份檔，請確認它是由本 App 匯出的 JSON 檔。'
        );
      } finally {
        event.target.value = '';
      }
    };

    updateMood();
    updateSymptoms();
  </script>
</body>
</html>
